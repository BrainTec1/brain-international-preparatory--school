<div class="min-h-screen bg-gradient-to-br from-navy via-navy-light to-navy flex items-center justify-center p-4 font-sans">

  <div class="w-full max-w-md">

    <div class="text-center mb-8">
      <div class="w-20 h-20 rounded-full bg-gold flex items-center justify-center text-navy font-bold text-3xl mx-auto mb-4 shadow-xl">BIS</div>
      <h1 class="text-2xl font-bold text-white font-display">Brain International School</h1>
      <p class="text-gold text-sm font-semibold mt-1">Educate. Inspire. Transform.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-2xl p-8">

      <h2 class="text-lg font-bold text-navy mb-1">Welcome back</h2>
      <p class="text-sm text-slate-500 mb-6">Sign in to your portal</p>

      <% if (error) { %>
        <div class="bg-red-50 border-l-4 border-red-500 text-red-800 p-3 rounded mb-4 text-sm">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success && success.length) { %>
        <div class="bg-green-50 border-l-4 border-green-500 text-green-800 p-3 rounded mb-4 text-sm">
          ✅ <%= success[0] %>
        </div>
      <% } %>

      <form method="POST" action="/login" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Email Address</label>
          <input type="email" name="email" required autofocus autocomplete="email"
                 value="<%= email || '' %>"
                 placeholder="you@braininternationalschool.edu.gh"
                 class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-gold focus:ring-2 focus:ring-gold/30 outline-none text-sm">
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Password</label>
          <input type="password" name="password" required autocomplete="current-password"
                 placeholder="••••••••"
                 class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-gold focus:ring-2 focus:ring-gold/30 outline-none text-sm">
        </div>

        <button type="submit"
                class="w-full bg-navy hover:bg-navy-light text-white py-3 rounded-lg font-bold transition">
          Sign In
        </button>
      </form>

      <div class="mt-6 pt-6 border-t border-slate-100 text-center text-xs text-slate-500">
        <a href="/" class="hover:text-gold">← Back to school website</a>
      </div>

    </div>

    <p class="text-center text-xs text-slate-300 mt-6">
      Protected by HTTPS · Role-based access · Activity logged
    </p>

  </div>

</div>
