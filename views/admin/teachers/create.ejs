<div class="flex items-center gap-3 mb-6">
  <a href="/admin/teachers" class="text-slate-400 hover:text-navy text-xl">←</a>
  <div>
    <h1 class="text-2xl md:text-3xl font-bold text-navy">Add New Teacher</h1>
    <p class="text-sm text-slate-500 mt-1">A Staff ID and login account will be auto-generated</p>
  </div>
</div>

<form method="POST" action="/admin/teachers" class="max-w-3xl">
  <div class="bg-white rounded-xl shadow-sm border border-slate-200">

    <div class="px-6 py-4 border-b border-slate-100">
      <h2 class="font-bold text-navy">Teacher Information</h2>
    </div>

    <div class="p-6 grid md:grid-cols-2 gap-5">

      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Full Name *</label>
        <input type="text" name="fullName" value="<%= formData.fullName || '' %>"
               class="w-full px-4 py-2.5 rounded-lg border <%= errors.fullName ? 'border-red-500' : 'border-slate-300' %> focus:border-gold outline-none text-sm">
        <% if (errors.fullName) { %><p class="text-xs text-red-600 mt-1"><%= errors.fullName %></p><% } %>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Phone *</label>
        <input type="text" name="phone" value="<%= formData.phone || '' %>"
               class="w-full px-4 py-2.5 rounded-lg border <%= errors.phone ? 'border-red-500' : 'border-slate-300' %> focus:border-gold outline-none text-sm">
        <% if (errors.phone) { %><p class="text-xs text-red-600 mt-1"><%= errors.phone %></p><% } %>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Email * <span class="text-slate-400 text-xs">(used for login)</span></label>
        <input type="email" name="email" value="<%= formData.email || '' %>"
               class="w-full px-4 py-2.5 rounded-lg border <%= errors.email ? 'border-red-500' : 'border-slate-300' %> focus:border-gold outline-none text-sm">
        <% if (errors.email) { %><p class="text-xs text-red-600 mt-1"><%= errors.email %></p><% } %>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Qualification</label>
        <input type="text" name="qualification" value="<%= formData.qualification || '' %>"
               placeholder="e.g., B.Ed, Diploma"
               class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-gold outline-none text-sm">
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Hire Date *</label>
        <input type="date" name="hireDate" value="<%= formData.hireDate || new Date().toISOString().split('T')[0] %>"
               class="w-full px-4 py-2.5 rounded-lg border <%= errors.hireDate ? 'border-red-500' : 'border-slate-300' %> focus:border-gold outline-none text-sm">
        <% if (errors.hireDate) { %><p class="text-xs text-red-600 mt-1"><%= errors.hireDate %></p><% } %>
      </div>

      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Status</label>
        <select name="status" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-gold outline-none text-sm">
          <option value="active" <%= formData.status === 'active' || !formData.status ? 'selected' : '' %>>Active</option>
          <option value="on_leave" <%= formData.status === 'on_leave' ? 'selected' : '' %>>On Leave</option>
          <option value="inactive" <%= formData.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
      </div>

      <div class="md:col-span-2 bg-blue-50 border-l-4 border-blue-500 p-4 rounded text-sm text-blue-900">
        ℹ️ <strong>Login details will be auto-created.</strong> The teacher can log in with the email above and password <code class="bg-white px-1 rounded">Teacher@</code> followed by the last 4 digits of their phone.
      </div>

    </div>

    <div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3 rounded-b-xl">
      <a href="/admin/teachers" class="px-5 py-2.5 rounded-lg text-slate-600 hover:bg-slate-200 text-sm font-semibold">Cancel</a>
      <button type="submit" class="bg-navy hover:bg-navy-light text-white px-6 py-2.5 rounded-lg font-bold text-sm">Save Teacher</button>
    </div>

  </div>
</form>
