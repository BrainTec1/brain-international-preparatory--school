<div class="flex items-center gap-3 mb-6">
  <a href="/admin/subjects" class="text-slate-400 hover:text-navy text-xl">←</a>
  <div>
    <h1 class="text-2xl md:text-3xl font-bold text-navy">Edit Subject</h1>
  </div>
</div>

<form method="POST" action="/admin/subjects/<%= subject.id %>" class="max-w-xl">
  <div class="bg-white rounded-xl shadow-sm border border-slate-200">
    <div class="p-6 space-y-5">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Subject Name *</label>
        <input type="text" name="name" value="<%= subject.name %>"
               class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-gold outline-none text-sm">
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Subject Code *</label>
        <input type="text" name="code" value="<%= subject.code %>" maxlength="10"
               class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-gold outline-none text-sm uppercase">
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Level *</label>
        <select name="level" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-gold outline-none text-sm">
          <option value="nursery" <%= subject.level === 'nursery' ? 'selected' : '' %>>Nursery</option>
          <option value="kg" <%= subject.level === 'kg' ? 'selected' : '' %>>Kindergarten</option>
          <option value="lower_primary" <%= subject.level === 'lower_primary' ? 'selected' : '' %>>Lower Primary</option>
          <option value="upper_primary" <%= subject.level === 'upper_primary' ? 'selected' : '' %>>Upper Primary</option>
          <option value="jhs" <%= subject.level === 'jhs' ? 'selected' : '' %>>JHS</option>
        </select>
      </div>
    </div>

    <div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3 rounded-b-xl">
      <a href="/admin/subjects" class="px-5 py-2.5 rounded-lg text-slate-600 hover:bg-slate-200 text-sm font-semibold">Cancel</a>
      <button type="submit" class="bg-navy hover:bg-navy-light text-white px-6 py-2.5 rounded-lg font-bold text-sm">Update Subject</button>
    </div>
  </div>
</form>
