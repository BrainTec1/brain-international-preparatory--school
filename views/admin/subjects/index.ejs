<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl md:text-3xl font-bold text-navy">Subjects</h1>
    <p class="text-sm text-slate-500 mt-1"><%= total %> subjects</p>
  </div>
  <a href="/admin/subjects/create" class="inline-flex items-center gap-2 bg-gold hover:bg-gold-light text-navy px-5 py-2.5 rounded-lg font-bold text-sm">
    + Add Subject
  </a>
</div>

<form method="GET" class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 mb-6 flex flex-col md:flex-row gap-3">
  <input type="text" name="search" value="<%= filters.search %>" placeholder="Search by name or code..."
         class="flex-1 px-4 py-2.5 rounded-lg border border-slate-300 focus:border-gold outline-none text-sm">
  <select name="level" class="px-4 py-2.5 rounded-lg border border-slate-300 focus:border-gold outline-none text-sm">
    <option value="">All Levels</option>
    <option value="nursery" <%= filters.level === 'nursery' ? 'selected' : '' %>>Nursery</option>
    <option value="kg" <%= filters.level === 'kg' ? 'selected' : '' %>>Kindergarten</option>
    <option value="lower_primary" <%= filters.level === 'lower_primary' ? 'selected' : '' %>>Lower Primary</option>
    <option value="upper_primary" <%= filters.level === 'upper_primary' ? 'selected' : '' %>>Upper Primary</option>
    <option value="jhs" <%= filters.level === 'jhs' ? 'selected' : '' %>>JHS</option>
  </select>
  <button class="bg-navy hover:bg-navy-light text-white px-6 py-2.5 rounded-lg font-semibold text-sm">Filter</button>
  <% if (filters.search || filters.level) { %>
    <a href="/admin/subjects" class="px-4 py-2.5 rounded-lg text-slate-500 hover:bg-slate-100 text-sm text-center">Clear</a>
  <% } %>
</form>

<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
  <% if (subjects.length === 0) { %>
    <div class="text-center py-16 px-4">
      <div class="text-6xl mb-4 opacity-40">📚</div>
      <p class="text-slate-500">No subjects yet.</p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-slate-600 uppercase text-xs tracking-wider">
          <tr>
            <th class="px-4 py-3 text-left">Code</th>
            <th class="px-4 py-3 text-left">Name</th>
            <th class="px-4 py-3 text-left">Level</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% subjects.forEach(function(s) { %>
            <tr class="border-t border-slate-100 hover:bg-slate-50">
              <td class="px-4 py-3 font-mono text-xs text-slate-600"><%= s.code %></td>
              <td class="px-4 py-3 font-semibold text-navy"><%= s.name %></td>
              <td class="px-4 py-3 text-slate-600 capitalize"><%= s.level.replace(/_/g, ' ') %></td>
              <td class="px-4 py-3 text-right whitespace-nowrap">
                <a href="/admin/subjects/<%= s.id %>/edit" class="text-gold font-semibold text-xs hover:underline">Edit</a>
                <form method="POST" action="/admin/subjects/<%= s.id %>/delete" class="inline ml-3" onsubmit="return confirm('Delete this subject?');">
                  <button type="submit" class="text-red-500 font-semibold text-xs hover:underline">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
