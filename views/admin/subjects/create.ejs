<div class="flex items-center gap-3 mb-6">
  <a href="/admin/subjects" class="text-slate-400 hover:text-navy text-xl">←</a>
  <div>
    <h1 class="text-2xl md:text-3xl font-bold text-navy">Add Subject</h1>
  </div>
</div>

<form method="POST" action="/admin/subjects" class="max-w-xl">
  <div class="bg-white rounded-xl shadow-sm border border-slate-200">
    <div class="p-6 space-y-5">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Subject Name *</label>
        <input type="text" name="name" value="<%= formData.name || '' %>" placeholder="e.g., Mathematics"
               class="w-full px-4 py-2.5 rounded-lg border <%= errors.name ? 'border-red-500' : 'border-slate-300' %> focus:border-gold outline-none text-sm">
        <% if (errors.name) { %><p class="text-xs text-red-600 mt-1"><%= errors.name %></p><% } %>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Subject Code *</label>
        <input type="text" name="code" value="<%= formData.code || '' %>" placeholder="e.g., MATH" maxlength="10"
               class="w-full px-4 py-2.5 rounded-lg border <%= errors.code ? 'border-red-500' : 'border-slate-300' %> focus:border-gold outline-none text-sm uppercase">
        <p class="text-xs text-slate-500 mt-1">Short code (2–10 characters). Uppercase automatically.</p>
        <% if (errors.code) { %><p class="text-xs text-red-600 mt-1"><%= errors.code %></p><% } %>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Level *</label>
        <select name="level" class="w-full px-4 py-2.5 rounded-lg border <%= errors.level ? 'border-red-500' : 'border-slate-300' %> focus:border-gold outline-none text-sm">
          <option value="">Select level</option>
          <option value="nursery" <%= formData.level === 'nursery' ? 'selected' : '' %>>Nursery</option>
          <option value="kg" <%= formData.level === 'kg' ? 'selected' : '' %>>Kindergarten</option>
          <option value="lower_primary" <%= formData.level === 'lower_primary' ? 'selected' : '' %>>Lower Primary</option>
          <option value="upper_primary" <%= formData.level === 'upper_primary' ? 'selected' : '' %>>Upper Primary</option>
          <option value="jhs" <%= formData.level === 'jhs' ? 'selected' : '' %>>JHS</option>
        </select>
        <% if (errors.level) { %><p class="text-xs text-red-600 mt-1"><%= errors.level %></p><% } %>
      </div>
    </div>

    <div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3 rounded-b-xl">
      <a href="/admin/subjects" class="px-5 py-2.5 rounded-lg text-slate-600 hover:bg-slate-200 text-sm font-semibold">Cancel</a>
      <button type="submit" class="bg-navy hover:bg-navy-light text-white px-6 py-2.5 rounded-lg font-bold text-sm">Save Subject</button>
    </div>
  </div>
</form>
