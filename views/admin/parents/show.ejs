<div class="flex items-center gap-3 mb-6">
  <a href="/admin/parents" class="text-slate-400 hover:text-navy text-xl">←</a>
  <div class="flex-1">
    <h1 class="text-2xl md:text-3xl font-bold text-navy"><%= parent.fullName %></h1>
    <p class="text-sm text-slate-500 mt-1 capitalize"><%= parent.relationship %></p>
  </div>
  <a href="/admin/parents/<%= parent.id %>/edit" class="bg-gold hover:bg-gold-light text-navy px-4 py-2 rounded-lg font-semibold text-sm">Edit</a>
</div>

<div class="grid md:grid-cols-3 gap-6">

  <div class="md:col-span-2 space-y-6">

    <div class="bg-white rounded-xl shadow-sm border border-slate-200">
      <div class="px-6 py-4 border-b border-slate-100">
        <h2 class="font-bold text-navy">Contact Information</h2>
      </div>
      <div class="p-6 grid md:grid-cols-2 gap-5 text-sm">
        <div>
          <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Phone</div>
          <div><%= parent.phone %></div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Email</div>
          <div><%= parent.email || '—' %></div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Occupation</div>
          <div><%= parent.occupation || '—' %></div>
        </div>
        <div>
          <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Address</div>
          <div><%= parent.address || '—' %></div>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200">
      <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
        <h2 class="font-bold text-navy">Linked Children (<%= parent.children.length %>)</h2>
      </div>

      <div class="p-6">
        <% if (parent.children.length === 0) { %>
          <p class="text-sm text-slate-500 text-center py-4">No children linked yet.</p>
        <% } else { %>
          <div class="space-y-3">
            <% parent.children.forEach(function(link) { %>
              <div class="flex items-center justify-between bg-slate-50 rounded-lg p-4">
                <div>
                  <div class="font-semibold text-navy"><%= link.student.firstName %> <%= link.student.lastName %></div>
                  <div class="text-xs text-slate-500 mt-0.5">
                    <span class="font-mono"><%= link.student.studentId %></span>
                    · <%= link.student.class ? link.student.class.name : 'No class' %>
                  </div>
                </div>
                <form method="POST" action="/admin/parents/<%= parent.id %>/unlink-child/<%= link.studentId %>" onsubmit="return confirm('Unlink this child?');">
                  <button type="submit" class="text-xs text-red-500 hover:text-red-700 font-semibold">Unlink</button>
                </form>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <% if (availableStudents.length > 0) { %>
        <div class="px-6 py-4 border-t border-slate-100 bg-slate-50">
          <h3 class="font-semibold text-navy text-sm mb-3">Link a child</h3>
          <form method="POST" action="/admin/parents/<%= parent.id %>/link-child" class="flex gap-2">
            <select name="studentId" required class="flex-1 px-4 py-2.5 rounded-lg border border-slate-300 focus:border-gold outline-none text-sm">
              <option value="">Select a student...</option>
              <% availableStudents.forEach(function(s) { %>
                <option value="<%= s.id %>">
                  <%= s.firstName %> <%= s.lastName %> — <%= s.studentId %> (<%= s.class ? s.class.name : 'No class' %>)
                </option>
              <% }) %>
            </select>
            <button type="submit" class="bg-navy hover:bg-navy-light text-white px-5 py-2.5 rounded-lg font-semibold text-sm">
              Link
            </button>
          </form>
        </div>
      <% } %>
    </div>

  </div>

  <div class="bg-white rounded-xl shadow-sm border border-slate-200">
    <div class="px-6 py-4 border-b border-slate-100">
      <h2 class="font-bold text-navy">Quick Actions</h2>
    </div>
    <div class="p-6 space-y-3">
      <a href="/admin/parents/<%= parent.id %>/edit" class="block w-full text-center bg-navy hover:bg-navy-light text-white px-4 py-2.5 rounded-lg font-semibold text-sm">Edit Parent</a>
      <form method="POST" action="/admin/parents/<%= parent.id %>/delete" onsubmit="return confirm('Remove this parent? This cannot be undone.');">
        <button type="submit" class="w-full text-center border-2 border-red-500 text-red-500 hover:bg-red-50 px-4 py-2.5 rounded-lg font-semibold text-sm">Remove Parent</button>
      </form>
      <a href="/admin/parents" class="block w-full text-center text-slate-500 hover:bg-slate-100 px-4 py-2.5 rounded-lg font-semibold text-sm">← Back to List</a>
    </div>
  </div>

</div>
