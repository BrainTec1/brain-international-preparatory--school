<div class="flex items-center gap-3 mb-6">
  <a href="/admin/classes" class="text-slate-400 hover:text-navy text-xl">←</a>
  <div class="flex-1">
    <h1 class="text-2xl md:text-3xl font-bold text-navy"><%= schoolClass.name %></h1>
    <p class="text-sm text-slate-500 mt-1 capitalize"><%= schoolClass.level.replace(/_/g, ' ') %> Level</p>
  </div>
  <a href="/admin/classes/<%= schoolClass.id %>/edit" class="bg-gold hover:bg-gold-light text-navy px-4 py-2 rounded-lg font-semibold text-sm">Edit</a>
</div>

<div class="grid md:grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 border-l-4 border-blue-500">
    <div class="text-3xl font-bold text-navy"><%= counts.total %></div>
    <div class="text-slate-500 text-sm mt-1">Total Students</div>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 border-l-4 border-green-500">
    <div class="text-3xl font-bold text-navy"><%= counts.active %></div>
    <div class="text-slate-500 text-sm mt-1">Active</div>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 border-l-4 border-blue-600">
    <div class="text-3xl font-bold text-navy"><%= counts.male %></div>
    <div class="text-slate-500 text-sm mt-1">Male</div>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 border-l-4 border-pink-500">
    <div class="text-3xl font-bold text-navy"><%= counts.female %></div>
    <div class="text-slate-500 text-sm mt-1">Female</div>
  </div>
</div>

<div class="grid md:grid-cols-3 gap-6">
  <div class="md:col-span-2 bg-white rounded-xl shadow-sm border border-slate-200">
    <div class="px-6 py-4 border-b border-slate-100">
      <h2 class="font-bold text-navy">Class Information</h2>
    </div>
    <div class="p-6 grid md:grid-cols-2 gap-5 text-sm">
      <div>
        <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Class Teacher</div>
        <div><%= schoolClass.classTeacher ? schoolClass.classTeacher.fullName : '—' %></div>
      </div>
      <div>
        <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Capacity</div>
        <div><%= schoolClass.capacity %> students</div>
      </div>
      <div>
        <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Level</div>
        <div class="capitalize"><%= schoolClass.level.replace(/_/g, ' ') %></div>
      </div>
      <div>
        <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Occupancy</div>
        <div><%= Math.round((counts.total / schoolClass.capacity) * 100) %>% full</div>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-slate-200">
    <div class="px-6 py-4 border-b border-slate-100">
      <h2 class="font-bold text-navy">Actions</h2>
    </div>
    <div class="p-6 space-y-3">
      <a href="/admin/classes/<%= schoolClass.id %>/edit" class="block w-full text-center bg-navy hover:bg-navy-light text-white px-4 py-2.5 rounded-lg font-semibold text-sm">Edit Class</a>
      <form method="POST" action="/admin/classes/<%= schoolClass.id %>/delete" onsubmit="return confirm('Delete this class?');">
        <button type="submit" class="w-full text-center border-2 border-red-500 text-red-500 hover:bg-red-50 px-4 py-2.5 rounded-lg font-semibold text-sm">Delete Class</button>
      </form>
      <a href="/admin/classes" class="block w-full text-center text-slate-500 hover:bg-slate-100 px-4 py-2.5 rounded-lg font-semibold text-sm">← Back</a>
    </div>
  </div>
</div>

<!-- Student list -->
<div class="bg-white rounded-xl shadow-sm border border-slate-200 mt-6">
  <div class="px-6 py-4 border-b border-slate-100">
    <h2 class="font-bold text-navy">Students in this Class</h2>
  </div>
  <% if (schoolClass.students.length === 0) { %>
    <div class="text-center py-12">
      <p class="text-slate-500">No students in this class yet.</p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-slate-600 uppercase text-xs tracking-wider">
          <tr>
            <th class="px-4 py-3 text-left">Student ID</th>
            <th class="px-4 py-3 text-left">Name</th>
            <th class="px-4 py-3 text-left">Gender</th>
            <th class="px-4 py-3 text-left">Status</th>
          </tr>
        </thead>
        <tbody>
          <% schoolClass.students.forEach(function(s) { %>
            <tr class="border-t border-slate-100 hover:bg-slate-50">
              <td class="px-4 py-3 font-mono text-xs"><%= s.studentId %></td>
              <td class="px-4 py-3 font-semibold text-navy">
                <a href="/admin/students/<%= s.id %>" class="hover:underline"><%= s.firstName %> <%= s.lastName %></a>
              </td>
              <td class="px-4 py-3 text-slate-600 capitalize"><%= s.gender %></td>
              <td class="px-4 py-3 text-slate-600 capitalize"><%= s.status %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
