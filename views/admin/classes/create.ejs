<div class="flex items-center gap-3 mb-6">
  <a href="/admin/classes" class="text-slate-400 hover:text-navy text-xl">←</a>
  <div>
    <h1 class="text-2xl md:text-3xl font-bold text-navy">Add New Class</h1>
  </div>
</div>

<form method="POST" action="/admin/classes" class="max-w-2xl">
  <div class="bg-white rounded-xl shadow-sm border border-slate-200">
    <div class="px-6 py-4 border-b border-slate-100">
      <h2 class="font-bold text-navy">Class Information</h2>
    </div>
    <div class="p-6 grid md:grid-cols-2 gap-5">
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Class Name *</label>
        <input type="text" name="name" value="<%= formData.name || '' %>" placeholder="e.g., Primary 5, JHS 2"
               class="w-full px-4 py-2.5 rounded-lg border <%= errors.name ? 'border-red-500' : 'border-slate-300' %> focus:border-gold outline-none text-sm">
        <% if (errors.name) { %><p class="text-xs text-red-600 mt-1"><%= errors.name %></p><% } %>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Level *</label>
        <select name="level" class="w-full px-4 py-2.5 rounded-lg border <%= errors.level ? 'border-red-500' : 'border-slate-300' %> focus:border-gold outline-none text-sm">
          <option value="">Select level</option>
          <option value="nursery" <%= formData.level === 'nursery' ? 'selected' : '' %>>Nursery</option>
          <option value="kg" <%= formData.level === 'kg' ? 'selected' : '' %>>Kindergarten</option>
          <option value="lower_primary" <%= formData.level === 'lower_primary' ? 'selected' : '' %>>Lower Primary</option>
          <option value="upper_primary" <%= formData.level === 'upper_primary' ? 'selected' : '' %>>Upper Primary</option>
          <option value="jhs" <%= formData.level === 'jhs' ? 'selected' : '' %>>JHS</option>
        </select>
        <% if (errors.level) { %><p class="text-xs text-red-600 mt-1"><%= errors.level %></p><% } %>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Capacity *</label>
        <input type="number" name="capacity" value="<%= formData.capacity || 40 %>" min="1" max="100"
               class="w-full px-4 py-2.5 rounded-lg border <%= errors.capacity ? 'border-red-500' : 'border-slate-300' %> focus:border-gold outline-none text-sm">
        <% if (errors.capacity) { %><p class="text-xs text-red-600 mt-1"><%= errors.capacity %></p><% } %>
      </div>

      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Class Teacher (optional)</label>
        <select name="classTeacherId" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-gold outline-none text-sm">
          <option value="">No teacher assigned</option>
          <% teachers.forEach(function(t) { %>
            <option value="<%= t.id %>" <%= formData.classTeacherId == t.id ? 'selected' : '' %>><%= t.fullName %> — <%= t.staffId %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3 rounded-b-xl">
      <a href="/admin/classes" class="px-5 py-2.5 rounded-lg text-slate-600 hover:bg-slate-200 text-sm font-semibold">Cancel</a>
      <button type="submit" class="bg-navy hover:bg-navy-light text-white px-6 py-2.5 rounded-lg font-bold text-sm">Save Class</button>
    </div>
  </div>
</form>
