<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | BIS Portal</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: {
        colors: {
          navy: { DEFAULT: '#0B1F3A', light: '#16345F' },
          gold: { DEFAULT: '#C9A227', light: '#E4C158' },
        },
        fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
      }}
    }
  </script>
</head>
<body class="bg-slate-50 min-h-screen flex">

  <aside class="w-64 bg-navy text-white min-h-screen p-5 flex-shrink-0 hidden md:flex md:flex-col">

    <div class="flex items-center gap-3 mb-8">
      <div class="w-10 h-10 rounded-full bg-gold flex items-center justify-center text-navy font-bold">B</div>
      <div>
        <div class="text-sm font-bold leading-tight">Brain International</div>
        <div class="text-[10px] text-gold uppercase tracking-wider"><%= roleLabel %></div>
      </div>
    </div>

    <nav class="flex-1 space-y-1 overflow-y-auto">

      <a href="/admin/dashboard"
         class="flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium <%= sidebarActive === 'dashboard' ? 'bg-gold text-navy font-semibold' : 'text-slate-300 hover:bg-white/10 hover:text-white' %> transition">
        <span>📊</span> Dashboard
      </a>

      <a href="/admin/students"
         class="flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium <%= sidebarActive === 'students' ? 'bg-gold text-navy font-semibold' : 'text-slate-300 hover:bg-white/10 hover:text-white' %> transition">
        <span>👨‍🎓</span> Students
      </a>

      <a href="/admin/teachers"
         class="flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium <%= sidebarActive === 'teachers' ? 'bg-gold text-navy font-semibold' : 'text-slate-300 hover:bg-white/10 hover:text-white' %> transition">
        <span>👨‍🏫</span> Teachers
      </a>

      <a href="/admin/parents"
         class="flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium <%= sidebarActive === 'parents' ? 'bg-gold text-navy font-semibold' : 'text-slate-300 hover:bg-white/10 hover:text-white' %> transition">
        <span>👪</span> Parents
      </a>

      <a href="/admin/classes"
         class="flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium <%= sidebarActive === 'classes' ? 'bg-gold text-navy font-semibold' : 'text-slate-300 hover:bg-white/10 hover:text-white' %> transition">
        <span>🏫</span> Classes
      </a>

      <a href="/admin/fees"
         class="flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium <%= sidebarActive === 'fees' ? 'bg-gold text-navy font-semibold' : 'text-slate-300 hover:bg-white/10 hover:text-white' %> transition">
        <span>💵</span> Fees
      </a>

    </nav>

    <div class="pt-4 mt-4 border-t border-white/10">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center text-sm font-bold">
          <%= user.name.charAt(0).toUpperCase() %>
        </div>
        <div class="flex-1 min-w-0">
          <div class="text-xs font-semibold truncate"><%= user.name %></div>
          <div class="text-[10px] text-slate-400 truncate"><%= user.email %></div>
        </div>
      </div>
      <form method="POST" action="/logout">
        <button class="w-full text-left text-xs text-red-300 hover:text-red-200 py-2 px-2 rounded hover:bg-red-500/10">
          ⏻ Sign out
        </button>
      </form>
    </div>

  </aside>

  <div class="flex-1 min-w-0 flex flex-col">

    <header class="bg-white border-b border-slate-200 sticky top-0 z-20">
      <div class="h-16 px-4 md:px-6 flex items-center justify-between gap-4">
        <h1 class="font-bold text-navy text-base md:text-lg truncate"><%= title %></h1>
        <span class="hidden sm:inline text-slate-500 text-xs"><%= new Date().toDateString() %></span>
      </div>
    </header>

    <% if (typeof success !== 'undefined' && success && success.length) { %>
      <div class="mx-4 md:mx-6 mt-4 bg-green-50 border-l-4 border-green-500 text-green-800 p-3 rounded text-sm">
        ✅ <%= success[0] %>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.length) { %>
      <div class="mx-4 md:mx-6 mt-4 bg-red-50 border-l-4 border-red-500 text-red-800 p-3 rounded text-sm">
        ⚠️ <%= error[0] %>
      </div>
    <% } %>

    <main class="flex-1 p-4 md:p-6 overflow-x-hidden">
      <%- body %>
    </main>

  </div>

</body>
</html>
